{
  "name": "tianshu-replica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "tianshu": "node bin/tianshu.mjs",
    "worker": "node bin/tianshu-worker.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:replication": "npm test",
    "check:environment": "node scripts/check-environment.mjs",
    "experiment:session": "node src/session-topology-experiment.mjs",
    "experiment:e1": "node src/experiments/e1-artifact-workspace.mjs",
    "experiment:e2": "node src/experiments/e2-research-planner.mjs",
    "experiment:e3": "node src/experiments/e3-review-repair.mjs",
    "experiment:e4": "node src/experiments/e4-storyboard.mjs",
    "experiment:e4:render": "node src/experiments/e4-storyboard.mjs --stage render",
    "experiment:e5": "node src/experiments/e5-acceptance.mjs",
    "experiment:continuity-smoke": "node src/experiments/continuity-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  }
}
